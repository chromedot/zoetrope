# --- System & Environment ---
comfyui-env/
.venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.db
# The studio's database is deliberately NOT tracked. It holds generation
# history and prompts -- this operator's content, not the software -- and this
# repo is public. It is also a binary blob, so two machines editing it produce
# an unmergeable conflict. It lives at data/story_studio.db and is created on
# first run by init_db().

*.pid
*.sock
*.pid.lock
*.pid.lock.tmp
pids/

# --- ComfyUI Core & Runtime ---
# We generally don't want to commit the ComfyUI engine itself, 
# as users should clone the latest version or use our setup script.
ComfyUI/

# --- Large Model Files ---
# Never commit these. They are too big.
models/
models (Copy)/
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.bin

# --- Outputs & Logs ---
output/
*.log
wget-log*
*.tmp

# --- User Specific Configs ---
# We keep templates, but ignore active local configs
__manager/
last_run.json
help_log.txt
user/

# --- Claude Code local state ---
.claude/settings.local.json
.claude/review-receipts/

# --- Test & Coverage Artifacts ---
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# --- Temporary/Backup Files ---
*.bak
*.swp

# Local secrets
.env
