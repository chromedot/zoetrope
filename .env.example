# Copy to .env and fill in. Nothing here is required to generate images,
# narrate them, or assemble a video -- the core pipeline needs no API keys.

# Optional. Enables the "refine prompt" button in the Studio, which rewrites a
# scene prompt via Gemini. Without it that one endpoint returns a friendly
# error and everything else works normally.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides. Defaults are derived from the repo location, so you only
# need these if you keep models or output somewhere else.
# COMFY_URL=http://127.0.0.1:8188/prompt
# ORIENTATION=vertical        # vertical (1080x1920 Shorts) | landscape (1920x1080)
# WORKFLOW_TEMPLATE=/abs/path/to/workflow_api.json
